# Copy to .env (same directory) and fill in real values. .env is git-ignored.
# Consumed by docker-compose.yaml for the Airflow + Spark stack (see README.md).

ENV=dev

# OLTP PostgreSQL (reachable from containers via the oltp-db-proxy bridge).
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=mobility_oltp
DB_USER=postgres
DB_PASSWORD=change-me

# Deterministic tokenization secret for GDPR erasure propagation.
# Minimum 16 characters. Generate one with: openssl rand -hex 32
# WARNING: rotating this key makes previously erased values irreproducible.
GDPR_HASH_KEY=change-me

# Docker gateway IP used by oltp-db-proxy to bind inside WSL.
# Verify with: ip route | awk '/default/ {print $3}'
DOCKER_HOST_GATEWAY=172.18.0.1
